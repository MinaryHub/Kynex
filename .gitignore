/target
**/*.rs.bk
.playwright-mcp/
# Benchmark results: written per run, kept out of history.
/bench-results/
# The project `kynex view` keeps by default in the directory it runs in
# (and the programs file it replaced).
/kynex-project.json
/kynex-project.json.new
# Held while a KYNEX has the project open (unreadable to others meanwhile).
*.json.lock
/kynex-programs.json
/kynex-programs.json.new
__pycache__/
