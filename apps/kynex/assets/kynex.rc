// KYNEX's programs as Windows shows them: their icon, and what they are.
#include <winver.h>

1 ICON "kynex.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION KYNEX_VERSION_COMMAS
PRODUCTVERSION KYNEX_VERSION_COMMAS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "CompanyName", "SMIC"
            VALUE "FileDescription", "KYNEX"
            VALUE "FileVersion", KYNEX_VERSION
            VALUE "ProductName", "KYNEX"
            VALUE "ProductVersion", KYNEX_VERSION
            VALUE "LegalCopyright", "(c) SMIC"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END
