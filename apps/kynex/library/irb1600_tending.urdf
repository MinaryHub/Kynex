<?xml version="1.0"?>
<!-- ABB IRB 1600-10/1.45, for machine tending; its tool is added by KYNEX.
     Joint origins, axes and frames as ROS-Industrial's abb_irb1600_support
     has them, which match the controller's: the same joint positions point
     the arm the same way, and tool0 is the controller's flange (tool0).
     Base to axis 2: 486.5 mm up, 150 mm out; upper arm 700 mm; axis 3 to
     the wrist 600 mm; wrist to flange 65 mm: 1.45 m reach. Limits and top
     speeds from ABB's product specification. Drawn in plain shapes. -->
<robot name="irb1600">
  <material name="abb_white"><color rgba="0.90 0.90 0.88 1"/></material>
  <material name="abb_grey"><color rgba="0.62 0.63 0.64 1"/></material>
  <material name="abb_dark"><color rgba="0.20 0.21 0.23 1"/></material>
  <link name="base_link">
    <visual><origin xyz="0 0 0.1"/><geometry><box size="0.48 0.48 0.2"/></geometry><material name="abb_dark"/></visual>
  </link>
  <joint name="base_link-base" type="fixed">
    <parent link="base_link"/><child link="base"/>
  </joint>
  <link name="base"/>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.141593" upper="3.141593" effort="1000" velocity="2.617994"/>
  </joint>
  <link name="link_1">
    <visual><origin xyz="0 0 0.27"/><geometry><cylinder radius="0.19" length="0.14"/></geometry><material name="abb_white"/></visual>
    <visual><origin xyz="0.07 0 0.42"/><geometry><box size="0.3 0.34 0.2"/></geometry><material name="abb_white"/></visual>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0.15 0 0.4865"/><axis xyz="0 1 0"/>
    <limit lower="-1.099557" upper="2.373648" effort="1000" velocity="2.792527"/>
  </joint>
  <link name="link_2">
    <visual><origin rpy="1.570796327 0 0"/><geometry><cylinder radius="0.1" length="0.3"/></geometry><material name="abb_white"/></visual>
    <visual><origin xyz="0 0.1 0.35"/><geometry><box size="0.13 0.09 0.82"/></geometry><material name="abb_white"/></visual>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0 0 0.7"/><axis xyz="0 1 0"/>
    <limit lower="-4.101524" upper="0.959931" effort="1000" velocity="2.967060"/>
  </joint>
  <link name="link_3">
    <visual><origin rpy="1.570796327 0 0"/><geometry><cylinder radius="0.09" length="0.24"/></geometry><material name="abb_white"/></visual>
    <visual><origin xyz="-0.05 0 0"/><geometry><box size="0.22 0.18 0.18"/></geometry><material name="abb_white"/></visual>
  </link>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.490659" upper="3.490659" effort="1000" velocity="5.585054"/>
  </joint>
  <link name="link_4">
    <visual><origin xyz="0.32 0 0" rpy="0 1.570796327 0"/><geometry><cylinder radius="0.06" length="0.42"/></geometry><material name="abb_white"/></visual>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/>
    <origin xyz="0.6 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.007129" upper="2.007129" effort="1000" velocity="6.981317"/>
  </joint>
  <link name="link_5">
    <visual><origin rpy="1.570796327 0 0"/><geometry><cylinder radius="0.055" length="0.13"/></geometry><material name="abb_grey"/></visual>
  </link>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/>
    <origin xyz="0.065 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-6.981317" upper="6.981317" effort="1000" velocity="8.028515"/>
  </joint>
  <link name="link_6">
    <visual><origin xyz="-0.01 0 0" rpy="0 1.570796327 0"/><geometry><cylinder radius="0.04" length="0.02"/></geometry><material name="abb_dark"/></visual>
  </link>
  <joint name="joint_6-tool0" type="fixed">
    <parent link="link_6"/><child link="tool0"/>
    <origin rpy="0 1.570796327 0"/>
  </joint>
  <link name="tool0"/>
</robot>
