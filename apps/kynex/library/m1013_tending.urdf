<?xml version="1.0"?>
<!-- Doosan Robotics M1013, for machine tending; its tool is added by KYNEX.
     Joint origins, axes, limits and top speeds as Doosan's
     dsr_description2 (m1013.urdf) has them, its quarter turns written out
     in full: the same joint positions as the controller's point the arm the
     same way, and link_6 is the controller's flange. All joints at zero,
     the arm stands upright: 152.5 mm to axis 2, 620 mm upper arm, 559 mm
     forearm, 121 mm to the flange; axis 2 34.5 mm to the side. 10 kg,
     1.3 m reach. Drawn in plain shapes. -->
<robot name="m1013">
  <material name="ds_white"><color rgba="0.92 0.92 0.90 1"/></material>
  <material name="ds_blue"><color rgba="0.12 0.36 0.70 1"/></material>
  <material name="ds_dark"><color rgba="0.20 0.21 0.23 1"/></material>
  <link name="base_link">
    <visual><origin xyz="0 0 0.07"/><geometry><cylinder radius="0.1" length="0.14"/></geometry><material name="ds_white"/></visual>
  </link>
  <joint name="base_link-base" type="fixed">
    <parent link="base_link"/><child link="base"/>
  </joint>
  <link name="base"/>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.1525"/><axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="346" velocity="2.0944"/>
  </joint>
  <link name="link_1">
    <visual><origin xyz="0 0 -0.01"/><geometry><cylinder radius="0.085" length="0.04"/></geometry><material name="ds_blue"/></visual>
    <visual><origin xyz="0 0.03 0" rpy="1.570796327 0 0"/><geometry><cylinder radius="0.085" length="0.17"/></geometry><material name="ds_white"/></visual>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0 0.0345 0" rpy="0 -1.570796327 -1.570796327"/><axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="346" velocity="2.0944"/>
  </joint>
  <link name="link_2">
    <visual><origin xyz="0.31 0 0" rpy="0 1.570796327 0"/><geometry><cylinder radius="0.065" length="0.5"/></geometry><material name="ds_white"/></visual>
    <visual><origin xyz="0.62 0 0"/><geometry><cylinder radius="0.075" length="0.15"/></geometry><material name="ds_white"/></visual>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0.62 0 0" rpy="0 0 1.570796327"/><axis xyz="0 0 1"/>
    <limit lower="-2.7925" upper="2.7925" effort="163" velocity="3.1416"/>
  </joint>
  <link name="link_3">
    <visual><origin xyz="0 0 0.08"/><geometry><cylinder radius="0.075" length="0.012"/></geometry><material name="ds_blue"/></visual>
    <visual><origin xyz="0 -0.27 0" rpy="1.570796327 0 0"/><geometry><cylinder radius="0.055" length="0.42"/></geometry><material name="ds_white"/></visual>
  </link>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="0 -0.559 0" rpy="1.570796327 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="50" velocity="3.927"/>
  </joint>
  <link name="link_4">
    <visual><origin xyz="0 0 -0.04"/><geometry><cylinder radius="0.055" length="0.08"/></geometry><material name="ds_white"/></visual>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/>
    <origin rpy="-1.570796327 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="50" velocity="3.927"/>
  </joint>
  <link name="link_5">
    <visual><geometry><cylinder radius="0.055" length="0.13"/></geometry><material name="ds_white"/></visual>
  </link>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/>
    <origin xyz="0 -0.121 0" rpy="1.570796327 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="50" velocity="3.927"/>
  </joint>
  <link name="link_6">
    <visual><origin xyz="0 0 -0.03"/><geometry><cylinder radius="0.045" length="0.05"/></geometry><material name="ds_blue"/></visual>
  </link>
  <joint name="link_6-tool0" type="fixed">
    <parent link="link_6"/><child link="tool0"/>
  </joint>
  <link name="tool0"/>
</robot>
